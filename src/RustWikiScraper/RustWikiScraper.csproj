<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RustWikiScraper</AssemblyName>
    <RootNamespace>RustWikiScraper</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.0</Version>
    <Product>Rust Wiki Scraper</Product>
    <AssemblyTitle>Rust Wiki Scraper</AssemblyTitle>
    <Company>Yanoee</Company>
    <Authors>Yanoee</Authors>
    <Description>Downloads Rust item icons, world pictures and item data from rusthelp.com.</Description>
    <Copyright>© 2026 Yanoee</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\logo.png" />
    <None Include="Assets\Fonts\LICENSE-FontAwesome.txt" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RustWikiScraper.Core\RustWikiScraper.Core.csproj" />
  </ItemGroup>

</Project>

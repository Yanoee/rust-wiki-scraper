<Window x:Class="RustWikiScraper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RustWikiScraper"
        Title="Rust Wiki Scraper" Width="1260" Height="840" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type ui:LibItem}">
            <Border x:Name="Tile" Width="122" Height="138" Margin="5" CornerRadius="16" BorderThickness="1.5" Cursor="Hand"
                    Background="{StaticResource Glass}" BorderBrush="Transparent" MouseLeftButtonUp="Tile_Click"
                    ui:Anim.Jelly="True">
                <Grid Margin="8,12,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Thumb}" Width="70" Height="70" Visibility="{Binding FileVisible}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xf03e;" FontSize="28" Foreground="{StaticResource Text3}"
                               Visibility="{Binding NoFileVisible}" />
                    <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="11.5"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#1FFFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#290A84FF" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#0A84FF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="Tint" Fill="#B80A0C12" />
            <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-300,0,0"
                     ui:Anim.Float="True" ui:Anim.FloatAmount="60" ui:Anim.FloatSeconds="9">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#550A84FF" Offset="0" />
                        <GradientStop Color="#000A84FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-280,-320"
                     ui:Anim.Float="True" ui:Anim.FloatAmount="70" ui:Anim.FloatSeconds="11">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#50BF5AF2" Offset="0" />
                        <GradientStop Color="#00BF5AF2" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="560" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="300,0,0,120"
                     ui:Anim.Float="True" ui:Anim.FloatAmount="50" ui:Anim.FloatSeconds="13">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#30FF9F0A" Offset="0" />
                        <GradientStop Color="#00FF9F0A" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="14,14,0,14" Padding="16,20" CornerRadius="24" Background="#0EFFFFFF">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,28">
                        <Image Source="/Assets/logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"
                               ui:Anim.Float="True" ui:Anim.FloatAmount="4" ui:Anim.Jelly="True" Cursor="Hand" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Rust Wiki" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Scraper" FontSize="12.5" Foreground="{StaticResource Text2}" />
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" CornerRadius="16" Background="#0FFFFFFF" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Text3}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Idle" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                            <TextBlock Text="v1.0.0" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Text3}" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="MENU" Style="{StaticResource Caps}" Margin="10,0,0,8" Foreground="{StaticResource Text3}" />
                        <RadioButton x:Name="NavDownload" Style="{StaticResource Nav}" Tag="&#xf0ed;" Content="Download" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavLibrary" Style="{StaticResource Nav}" Tag="&#xf302;" Content="Library" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xf013;" Content="Settings" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0">
                    <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Tag="&#xf068;" Click="Min_Click" ToolTip="Minimize" />
                    <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Tag="&#xf2d0;" Click="Max_Click" ToolTip="Maximize" />
                    <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Tag="&#xf00d;" Click="Close_Click" ToolTip="Close" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="28,0,28,24">

                    <Grid x:Name="PageDownload">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Download" Style="{StaticResource H1}" />
                            <TextBlock Text="Pull world pictures, item icons and item data from rusthelp.com." Style="{StaticResource Sub}" Margin="0,4,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="-6,0">
                            <CheckBox x:Name="OptWorld" Style="{StaticResource OptionCard}" Tag="&#xf57d;" Background="{StaticResource TealGrad}" IsChecked="True" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="World pictures" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="NPCs, crates, vendors" Style="{StaticResource Sub}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="OptItems" Style="{StaticResource OptionCard}" Tag="&#xf1b2;" Background="{StaticResource OrangeGrad}" IsChecked="True" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Item icons" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="512 × 512 PNG" Style="{StaticResource Sub}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="OptCatalog" Style="{StaticResource OptionCard}" Tag="&#xf15c;" Background="{StaticResource BlueGrad}" IsChecked="True" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Item catalog" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="ids, names, texts" Style="{StaticResource Sub}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="OptRedo" Style="{StaticResource OptionCard}" Tag="&#xf2f1;" Background="{StaticResource PurpleGrad}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Re-download" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="overwrite saved files" Style="{StaticResource Sub}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </UniformGrid>

                        <DockPanel Grid.Row="2" Margin="0,18,0,0">
                            <Button x:Name="BtnStart" Style="{StaticResource PrimaryBtn}" Tag="&#xf04b;" Content="Start" Padding="26,12" FontSize="14" Click="Start_Click" />
                            <Button x:Name="BtnStop" Style="{StaticResource DangerBtn}" Tag="&#xf04d;" Content="Stop" Padding="22,12" FontSize="14" Margin="10,0,0,0" Click="Stop_Click" IsEnabled="False" />
                            <Button x:Name="BtnCheck" Style="{StaticResource BigBtn}" Tag="&#xf021;" Content="Check for updates" Margin="10,0,0,0" Click="Check_Click" />
                            <TextBlock x:Name="PhaseText" Text="Ready" Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                        </DockPanel>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ProgressTitle" Text="Nothing running" Style="{StaticResource CardTitle}" />
                                    <ProgressBar x:Name="Progress" Style="{StaticResource Capsule}" Margin="0,12,0,0" Maximum="1" Value="0" />
                                </StackPanel>
                                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                           FontWeight="SemiBold" Margin="24,0,4,0" VerticalAlignment="Center" MinWidth="86" TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="4" Rows="1" Columns="5" Margin="-6,14,-6,0">
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Chip}" Tag="&#xf058;" Background="{StaticResource GreenGrad}" Width="36" Height="36" FontSize="15" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SAVED" Style="{StaticResource Caps}" />
                                        <TextBlock x:Name="StatSaved" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Chip}" Tag="&#xf04e;" Background="{StaticResource GrayGrad}" Width="36" Height="36" FontSize="15" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SKIPPED" Style="{StaticResource Caps}" />
                                        <TextBlock x:Name="StatSkipped" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Chip}" Tag="&#xf057;" Background="{StaticResource RedGrad}" Width="36" Height="36" FontSize="15" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FAILED" Style="{StaticResource Caps}" />
                                        <TextBlock x:Name="StatFailed" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Chip}" Tag="&#xf625;" Background="{StaticResource BlueGrad}" Width="36" Height="36" FontSize="15" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SPEED" Style="{StaticResource Caps}" />
                                        <TextBlock x:Name="StatSpeed" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Chip}" Tag="&#xf252;" Background="{StaticResource OrangeGrad}" Width="36" Height="36" FontSize="15" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="TIME LEFT" Style="{StaticResource Caps}" />
                                        <TextBlock x:Name="StatEta" Text="-" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16,10,10">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,10,10">
                                    <TextBlock Text="Activity" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Tag="&#xf12d;" Content="Clear" Padding="12,6" FontSize="12" Click="Clear_Click" />
                                    <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" Margin="0,0,10,0" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="FilterAll" Style="{StaticResource Seg}" Content="All" GroupName="LogFilter" IsChecked="True" Checked="Filter_Checked" />
                                            <RadioButton x:Name="FilterProblems" Style="{StaticResource Seg}" Content="Problems" GroupName="LogFilter" Checked="Filter_Checked" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <ListBox x:Name="LogList" Style="{StaticResource PlainList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:LogLine}">
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Margin="0,1" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="PageLibrary" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Library" Style="{StaticResource H1}" />
                            <TextBlock x:Name="LibSub" Text="What you have downloaded." Style="{StaticResource Sub}" Margin="0,4,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,14">
                            <Border CornerRadius="12" Background="{StaticResource Fill}" Padding="12,0" Width="320" Height="38">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xf002;" FontSize="13" Foreground="{StaticResource Text2}" />
                                    <Grid Margin="10,0,0,0">
                                        <TextBlock x:Name="SearchHint" Text="Search name, shortname, Turkish or ID" Foreground="{StaticResource Text3}"
                                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                                 CaretBrush="{StaticResource Text}" VerticalAlignment="Center" FontSize="13" TextChanged="Search_Changed" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SegBox}" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="KindItems" Style="{StaticResource Seg}" Content="Items" GroupName="Kind" IsChecked="True" Checked="Kind_Checked" />
                                    <RadioButton x:Name="KindWorld" Style="{StaticResource Seg}" Content="World" GroupName="Kind" Checked="Kind_Checked" />
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="TrOnly" Style="{StaticResource Switch}" Content="Only TR kontrol et" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="TrOnly_Changed" Unchecked="TrOnly_Changed" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Btn}" Tag="&#xf021;" Content="Reload" Click="Reload_Click" />
                                <Button Style="{StaticResource Btn}" Tag="&#xf56e;" Content="Export CSV" Margin="10,0,0,0" Click="Export_Click" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="8,8,4,8">
                                <ListBox x:Name="LibList" Style="{StaticResource PlainList}" SizeChanged="LibList_SizeChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:LibRow}">
                                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="20">
                                <Grid>
                                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xf49e;" FontSize="64" Foreground="{StaticResource Text3}"
                                                   ui:Anim.Float="True" ui:Anim.FloatAmount="8" />
                                        <TextBlock Text="Nothing here yet" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,18,0,4" />
                                        <TextBlock Text="Run a download, or clear the search." Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                                        <Border DockPanel.Dock="Top" CornerRadius="18" Height="196" Background="#0FFFFFFF">
                                            <Grid>
                                                <Image x:Name="DetailImage" Width="160" Height="160" RenderOptions.BitmapScalingMode="HighQuality"
                                                       ui:Anim.Float="True" ui:Anim.FloatAmount="6" ui:Anim.Jelly="True" />
                                                <TextBlock x:Name="DetailNoImage" Style="{StaticResource Icon}" Text="&#xf03e;" FontSize="48"
                                                           Foreground="{StaticResource Text3}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Bottom">
                                            <Button x:Name="BtnCopyShort" Style="{StaticResource Btn}" Tag="&#xf0c5;" Content="Copy shortname" HorizontalContentAlignment="Left" Margin="0,4,0,0" Click="CopyShort_Click" />
                                            <Button x:Name="BtnCopyId" Style="{StaticResource Btn}" Tag="&#xf0c5;" Content="Copy ID" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="CopyId_Click" />
                                            <Button x:Name="BtnOpenPic" Style="{StaticResource Btn}" Tag="&#xf35d;" Content="Open picture" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="OpenPic_Click" />
                                            <Button x:Name="BtnShowFolder" Style="{StaticResource Btn}" Tag="&#xf07c;" Content="Show in folder" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="ShowFolder_Click" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="DetailName" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="DetailTr" Style="{StaticResource Sub}" FontSize="13.5" Margin="0,2,0,0" />
                                                <WrapPanel x:Name="DetailBadges" Margin="0,10,0,0" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Shortname" Foreground="{StaticResource Text3}" Margin="0,3" />
                                                    <TextBlock x:Name="DetailShort" Grid.Column="1" FontFamily="{StaticResource MonoFont}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="DetailIdLabel" Grid.Row="1" Text="ID" Foreground="{StaticResource Text3}" Margin="0,3" />
                                                    <TextBlock x:Name="DetailId" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource MonoFont}" Margin="0,3" />
                                                    <TextBlock x:Name="DetailUpdatedLabel" Grid.Row="2" Text="Updated" Foreground="{StaticResource Text3}" Margin="0,3" />
                                                    <TextBlock x:Name="DetailUpdated" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource MonoFont}" Margin="0,3" />
                                                </Grid>
                                                <TextBlock x:Name="DetailDesc" Style="{StaticResource Sub}" Margin="0,12,0,0" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform />
                        </ScrollViewer.RenderTransform>
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Settings" Style="{StaticResource H1}" />
                                <TextBlock Text="Saved next to the app in RustWikiScraper.settings.json." Style="{StaticResource Sub}" Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Chip}" Tag="&#xf07b;" Background="{StaticResource BlueGrad}" Width="34" Height="34" FontSize="14" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Output folder" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="World pictures, item icons and catalog.json go here." Style="{StaticResource Sub}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Tag="&#xf35d;" Content="Open" Margin="8,0,0,0" Click="OpenOut_Click" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Tag="&#xf07c;" Content="Change" Margin="8,0,0,0" Click="ChangeOut_Click" />
                                        <Border CornerRadius="10" Background="{StaticResource Fill}" Padding="12,9">
                                            <TextBlock x:Name="OutPath" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}">
                                        <StackPanel x:Name="ThreadsPanel" Orientation="Horizontal" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Chip}" Tag="&#xf0e7;" Background="{StaticResource OrangeGrad}" Width="34" Height="34" FontSize="14" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Parallel downloads" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Pictures at once. rusthelp's image server handled 8 with no limits." Style="{StaticResource Sub}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"
                                               ui:Anim.Float="True" ui:Anim.FloatAmount="4" ui:Anim.Jelly="True" Cursor="Hand" />
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Rust Wiki Scraper" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="Version 1.0.0" Style="{StaticResource Sub}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,6"
                                                   Text="Item data: rusthelp.com/downloads/admin-item-list-public.json (one request)" />
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,6"
                                                   Text="Pictures: cdn.rusthelp.com (source PNGs, saved as 512 × 512)" />
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,6"
                                                   Text="Turkish names in catalog.json are never overwritten." />
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,6"
                                                   Text="Not affiliated with rusthelp.com or Facepunch Studios. Rust item pictures belong to Facepunch." />
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12"
                                                   Text="Icons: Font Awesome Free by @fontawesome, fontawesome.com (CC BY 4.0, font SIL OFL 1.1)" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" CornerRadius="18"
                Background="#E62C2C30" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="16,10"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform Y="-70" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xf058;" FontSize="16" Foreground="{StaticResource Green}" />
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

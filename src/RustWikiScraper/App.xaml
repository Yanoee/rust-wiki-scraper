<Application x:Class="RustWikiScraper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RustWikiScraper"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <FontFamily x:Key="FA">pack://application:,,,/Assets/Fonts/#Font Awesome 7 Free</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <Color x:Key="BlueC">#0A84FF</Color>
        <Color x:Key="IndigoC">#5E5CE6</Color>
        <Color x:Key="PurpleC">#BF5AF2</Color>
        <Color x:Key="PinkC">#FF375F</Color>
        <SolidColorBrush x:Key="Blue" Color="#0A84FF" />
        <SolidColorBrush x:Key="Green" Color="#30D158" />
        <SolidColorBrush x:Key="Red" Color="#FF453A" />
        <SolidColorBrush x:Key="Yellow" Color="#FFD60A" />
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A" />
        <SolidColorBrush x:Key="Teal" Color="#64D2FF" />
        <SolidColorBrush x:Key="Purple" Color="#BF5AF2" />
        <SolidColorBrush x:Key="Text" Color="#F5F5F7" />
        <SolidColorBrush x:Key="Text2" Color="#99EBEBF5" />
        <SolidColorBrush x:Key="Text3" Color="#5CEBEBF5" />
        <SolidColorBrush x:Key="Glass" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="GlassHi" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="Fill" Color="#29767680" />
        <SolidColorBrush x:Key="Line" Color="#1AFFFFFF" />
        <LinearGradientBrush x:Key="GlassBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BlueGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2E9BFF" Offset="0" />
            <GradientStop Color="#5E5CE6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4BE07A" Offset="0" />
            <GradientStop Color="#1FA855" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrangeGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB340" Offset="0" />
            <GradientStop Color="#FF7A1A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D27BFF" Offset="0" />
            <GradientStop Color="#8E44E0" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B5E" Offset="0" />
            <GradientStop Color="#E0302A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TealGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7EE0FF" Offset="0" />
            <GradientStop Color="#2A9FD6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GrayGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E8E93" Offset="0" />
            <GradientStop Color="#5A5A60" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FA}" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Glass}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="Chip" TargetType="ContentControl">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" />
                            </Border.Effect>
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Foreground="White"
                                       FontSize="{TemplateBinding FontSize}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource GlassHi}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ui:Anim.Jelly" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="H" CornerRadius="12" Background="White" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                                <TextBlock x:Name="Ico" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="13"
                                           ui:Anim.Spin="{TemplateBinding ui:Anim.Spin}" />
                                <ContentPresenter x:Name="Txt" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Txt" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="H" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="H" Property="Opacity" Value="0.16" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource BlueGrad}" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0A84FF" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource RedGrad}" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="BigBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="22,12" />
        </Style>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="Transparent">
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="12"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="Transparent">
                            <TextBlock x:Name="T" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="13"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF453A" />
                                <Setter TargetName="T" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="46" Height="28">
                                <Border x:Name="Track" CornerRadius="14" Background="#39393D" />
                                <Ellipse x:Name="Knob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.45" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.45" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionCard" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ui:Anim.Jelly" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card" CornerRadius="20" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassBorder}"
                                BorderThickness="1" Padding="16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentControl Style="{StaticResource Chip}" Tag="{TemplateBinding Tag}" Background="{TemplateBinding Background}"
                                                HorizontalAlignment="Left" ui:Anim.Float="True" ui:Anim.FloatAmount="3" />
                                <ContentPresenter Grid.Row="1" Margin="2,14,0,0" />
                                <Grid Width="46" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border x:Name="Track" CornerRadius="14" Background="#39393D" />
                                    <Ellipse x:Name="Knob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1F0A84FF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#800A84FF" />
                                <Setter TargetName="Track" Property="Background" Value="#30D158" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.45" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.45" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="8" Background="Transparent" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#636366" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="B" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Fill}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="ui:Anim.Jelly" Value="True" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="14" Background="Transparent" Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Chip" Width="32" Height="32" CornerRadius="10" Background="#14FFFFFF">
                                    <TextBlock x:Name="I" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="14"
                                               Foreground="{StaticResource Text2}" />
                                </Border>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1FFFFFFF" />
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource BlueGrad}" />
                                <Setter TargetName="I" Property="Foreground" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Capsule" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="#1FFFFFFF" />
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0A84FF" Offset="0" />
                                        <GradientStop Color="#5E5CE6" Offset="0.6" />
                                        <GradientStop Color="#BF5AF2" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Rectangle x:Name="Shine" Width="140" HorizontalAlignment="Left">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="-140" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-140" To="1100" Duration="0:0:2.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ThumbT" TargetType="Thumb">
            <Border x:Name="T" CornerRadius="3" Background="#33FFFFFF" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,6">
                            <Track.Thumb>
                                <Thumb Template="{StaticResource ThumbT}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Margin="6,2">
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource ThumbT}" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlainItem}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

    </Application.Resources>
</Application>
